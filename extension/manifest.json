{
  "manifest_version": 3,
  "name": "PropWire",
  "version": "1.2.0",
  "description": "Institutional quantitative player props terminal and CLV ledger for NFL & NBA.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://propstein.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open PropWire"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
