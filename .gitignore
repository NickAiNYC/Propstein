!data/raw_espn_captures/*.json
# Local jsonl logs stay untracked except the append-only game-context journal
# and the two existing feed exceptions. The journal is small and is what CI
# uses to restore capture times. It is not part of the frozen model hashes.
*.jsonl
!snapshots/*.jsonl
!viewer/feeds/nba_model/*.jsonl
!viewer/precommit_log.jsonl
!data/game_context_captures.jsonl
