// Propstein 2.0 — preview schema (SQLite)
// Canonical production schema: prisma/schema.postgres.prisma (Supabase/Neon Postgres)
//
// Player ID namespaces (v2 fix — no more collisions):
//   espn-nba-{espnAthleteId}  canonical ESPN box-score players (team/pos/form/stats)
//   nba-{nbaStatsId}           nba_api registry-only players (no ESPN enhancement yet)
//   nfl-{nameKey}              snapshot v1 NFL players (receiving model slate)
// Dedupe guard: @@unique([league, nameKey]) — ESPN wins on merge at ingest time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id         String    @id // e.g. espn-nba-401584793
  league     String // NBA | NFL | NHL
  season     Int
  week       Int?
  slug       String? // e.g. 2026_07_NE_CHI (snapshot games)
  startTime  DateTime
  state      String // pre | in | post
  detail     String? // "Final" | "Q3 8:12" | tip-off time
  homeTeam   String
  homeScore  Int?
  awayTeam   String
  awayScore  Int?
  venue      String?
  broadcast  String?
  oddsLine   String? // formatted moneyline/spread string
  rawPayload Json?
  updatedAt  DateTime  @updatedAt
  players    Player[]
  props      Prop[]

  @@index([league, startTime])
  @@index([league, state])
}

model Player {
  id           String   @id
  league       String
  name         String
  nameKey      String // lowercased trimmed dedupe key
  team         String?
  position     String?
  jersey       Int?
  heightCm     Int?
  weightKg     Int?
  headshot     String?
  espnId       String? // raw ESPN athlete id (espn-nba-* records)
  nbaStatsId   String? // raw NBA stats id (nba-* records)
  source       String // espn | nba_registry | snapshot_v1
  formSummary  Json? // rolling box-score form — PRO gate
  statsSummary Json? // season averages
  games        Game[]
  props        Prop[]
  updatedAt    DateTime @updatedAt

  @@unique([league, nameKey])
  @@index([league, team])
  @@index([nameKey])
}

model Prop {
  id         String   @id // slate|playerId|market|book|line
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId     String?
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  league     String
  slate      String // e.g. 2026-W08 | 2026-11-03
  market     String // receiving_yards | receptions | points | rebounds ...
  line       Float
  fairLine   Float?
  overOdds   Int? // American odds
  underOdds  Int?
  book       String
  bestSide   String? // OVER | UNDER
  // model columns — PRO gate (stripped from free API responses)
  probWin    Float?
  fairOdds   Int? // American fair odds at model probability
  ev         Float? // expected value per 1u stake, best side
  kelly      Float? // full-Kelly stake fraction, capped at 0.25
  // free tier
  lean       String? // WATCH | PASS — directional lean for free tier
  verified   Boolean  @default(false)
  observedAt DateTime
  rawPayload Json?
  updatedAt  DateTime @updatedAt

  @@unique([slate, playerId, market, book, line])
  @@index([slate, league])
  @@index([league, observedAt])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  displayName      String?
  isPro            Boolean  @default(false)
  subscriptionTier String   @default("free") // free | pro
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
