// Propstein 2.0 — canonical production schema (Supabase / Neon Postgres)
// Preview/dev schema: prisma/schema.prisma (SQLite)
//
// Player ID namespaces (v2 fix — no more collisions):
//   espn-nba-{espnAthleteId}  canonical ESPN box-score players
//   nba-{nbaStatsId}           nba_api registry-only players
//   nfl-{nameKey}              snapshot v1 NFL players
// Dedupe guard: @@unique([league, nameKey]) — ESPN wins on merge at ingest time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Game {
  id         String    @id // e.g. espn-nba-401584793
  league     String // NBA | NFL | NHL
  season     Int
  week       Int?
  slug       String? // e.g. 2026_07_NE_CHI (snapshot games)
  startTime  DateTime
  state      String // pre | in | post
  detail     String?
  homeTeam   String
  homeScore  Int?
  awayTeam   String
  awayScore  Int?
  venue      String?
  broadcast  String?
  oddsLine   String?
  rawPayload Json? // raw ESPN event, JsonB in Postgres
  updatedAt  DateTime  @updatedAt
  players    Player[]
  props      Prop[]

  @@index([league, startTime])
  @@index([league, state])
}

model Player {
  id           String   @id
  league       String
  name         String
  nameKey      String
  team         String?
  position     String?
  jersey       Int?
  heightCm     Int?
  weightKg     Int?
  headshot     String?
  espnId       String?
  nbaStatsId   String?
  source       String
  formSummary  Json? // rolling box-score form — PRO gate
  statsSummary Json? // season averages
  games        Game[]
  props        Prop[]
  updatedAt    DateTime @updatedAt

  @@unique([league, nameKey])
  @@index([league, team])
  @@index([nameKey])
}

model Prop {
  id         String   @id
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId     String?
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  league     String
  slate      String
  market     String
  line       Float
  fairLine   Float?
  overOdds   Int?
  underOdds  Int?
  book       String
  bestSide   String?
  probWin    Float?
  fairOdds   Int?
  ev         Float?
  kelly      Float?
  lean       String?
  verified   Boolean  @default(false)
  observedAt DateTime
  rawPayload Json?
  updatedAt  DateTime @updatedAt

  @@unique([slate, playerId, market, book, line])
  @@index([slate, league])
  @@index([league, observedAt])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  displayName      String?
  isPro            Boolean  @default(false)
  subscriptionTier String   @default("free")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
