{"#detailContent":{"innerHTML":"\n      <div class=\"detail-hero\">\n        <div class=\"detail-stat\">\n          <span>Book Offer</span>\n          <strong class=\"text-accent\">\n            <span class=\"hero-side-pill pill-over\">OVER</span>\n            2.5 <small class=\"odds-val\">-110</small>\n          </strong>\n          <small class=\"cell-sub\">Synthetic Book A · Verified</small>\n        </div>\n        <div class=\"detail-stat detail-stat-fair\">\n          <div class=\"detail-stat-head\">\n            <span>Model Fair</span>\n            <span class=\"detail-stat-badge\">P(over fair) 50.0%</span>\n          </div>\n          <strong class=\"text-white\">25.0 <small class=\"text-dim\" style=\"font-size:11px;\">(μ 30.6)</small></strong>\n          <small class=\"cell-sub\">Continuous median · 144G baseline</small>\n          <div class=\"detail-fair-plot\">\n      <div class=\"bullet-container\" title=\"80% CI: 14–45y | Fair: 25.0 | Proj: 30.6 | Book: 2.5\">\n        <div class=\"bullet-top-readout tnum\">\n          <div><span class=\"bullet-dim\">FAIR</span> <strong class=\"bullet-bold text-fair font-mono tnum\">25.0</strong></div>\n          <span class=\"split-divider split-divider-tight\">|</span>\n          <div><span class=\"bullet-dim\">PROJ</span> <strong class=\"bullet-bold text-accent font-mono tnum proj-glow\">30.6</strong></div>\n        </div>\n        <svg class=\"bullet-svg\" viewBox=\"0 0 100 14\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n          <!-- Background Track (0 to maxScale) -->\n          <rect class=\"bullet-track\" x=\"0\" y=\"5\" width=\"100\" height=\"4\" rx=\"1.5\" fill=\"#2a2d35\" />\n          <!-- 80% Confidence Interval Bar -->\n          <rect class=\"bullet-fill\" x=\"7.4\" y=\"4.5\" width=\"16.3\" height=\"5\" rx=\"1\" fill=\"#465264\" />\n          <!-- Model Fair-to-Projection Visual Delta Fill -->\n          <rect class=\"bullet-fp-delta\" x=\"13.2\" y=\"4.5\" width=\"3.0\" height=\"5\" rx=\"1\" fill=\"rgba(56, 189, 248, 0.28)\" />\n          <!-- Edge Delta Highlight -->\n          <rect x=\"1.3\" y=\"4.5\" width=\"11.8\" height=\"5\" fill=\"rgba(132, 204, 22, 0.32)\" />\n          <!-- Book Line Marker (Crisp Vertical Amber Tick) -->\n          <line class=\"bullet-book-marker\" x1=\"1.3\" y1=\"1\" x2=\"1.3\" y2=\"13\" stroke=\"#d9a441\" stroke-width=\"1.8\" />\n          <!-- Fair Line Marker (Solid White Tick) -->\n          <line class=\"bullet-fair-marker\" x1=\"13.2\" y1=\"2.5\" x2=\"13.2\" y2=\"11.5\" stroke=\"#e2e8f0\" stroke-width=\"1.6\" />\n          <!-- Model Projection Mean (Volt Green Dot) -->\n          <circle class=\"bullet-proj-marker\" cx=\"16.1\" cy=\"7\" r=\"2.5\" fill=\"#3ccf91\" stroke=\"#0f131a\" stroke-width=\"0.8\" />\n        </svg>\n        <div class=\"bullet-bottom-sub\">\n          <span class=\"bullet-ci-wrap\">80% <span class=\"bullet-ci-tag\">14–45y</span></span>\n          <span class=\"bullet-bk\">Bk 2.5</span>\n        </div>\n      </div></div>\n        </div>\n        <div class=\"detail-stat actionable\"><span>Price check</span><strong>+11.0%</strong><small class=\"cell-sub\">Return +5.0% · Stake 3.00%</small></div>\n      </div>\n\n      \n\n      <!-- Unified Price Discovery & 10% Gate Hurdle Timeline -->\n      <div class=\"quant-ruler-card\">\n      <div class=\"quant-ruler-header\"><span class=\"quant-ruler-title\">Price discovery</span><span class=\"quant-ruler-delta\">+22.5 yds vs offer (OVER)</span></div>\n      <div class=\"quant-ruler-track-wrap\" role=\"img\" aria-label=\"Offer 2.5, fair 25.0, hurdle 19.0 yds\">\n        <div class=\"quant-ruler-lane top\"><span class=\"ruler-value-label top\" style=\"left:5.0%\">OFFER 2.5</span></div>\n        <svg class=\"quant-ruler-svg\" viewBox=\"0 0 100 12\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n          <rect x=\"0\" y=\"4\" width=\"100\" height=\"4\" rx=\"2\" fill=\"rgba(255,255,255,0.09)\" />\n          <rect x=\"5.0\" y=\"4\" width=\"66.4\" height=\"4\" rx=\"2\" fill=\"rgba(128,198,246,0.55)\" />\n          \n          <line x1=\"5.0\" x2=\"5.0\" y1=\"1\" y2=\"11\" stroke=\"#fff\" stroke-width=\".7\" />\n          <line x1=\"71.4\" x2=\"71.4\" y1=\"1\" y2=\"11\" stroke=\"#80c6f6\" stroke-width=\".7\" />\n          <line x1=\"95.0\" x2=\"95.0\" y1=\"1\" y2=\"11\" stroke=\"#b7e5ff\" stroke-width=\".7\" />\n        </svg>\n        <div class=\"quant-ruler-lane bottom\"><span class=\"ruler-value-label bottom\" style=\"left:83.2%\">HURDLE 19.0 · FAIR 25.0</span></div>\n      </div><p class=\"quant-ruler-copy\">Model gate threshold: up to 19.0 yds. Check execution status before logging.</p></div>\n\n      <!-- What-If Simulator + Teammate Ripple Preview -->\n      \n      <div class=\"scenario-box\">\n        <div class=\"scenario-header\">\n          <h4><svg class=\"prop-icon icon-surge\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:14px;height:14px;\"><path d=\"M1.5 8h3l2-5 3.5 10 2.5-6 1.5 2.5 2-.5\"/></svg> \"What-If\" Target Share Simulator</h4>\n          <button type=\"button\" class=\"scenario-reset-btn\" id=\"scenarioResetBtn\">Reset to Model (10.6%)</button>\n        </div>\n        <p style=\"font-size:11px; color:var(--muted); margin:0 0 8px;\">Adjust target share to simulate injury vacancies or usage changes.</p>\n        <div class=\"scenario-slider-row\">\n          <input type=\"range\" id=\"targetShareSlider\" min=\"0.05\" max=\"0.45\" step=\"0.01\" value=\"0.11\">\n          <span class=\"scenario-val\" id=\"scenarioShareVal\">11%</span>\n        </div>\n        <div class=\"scenario-results\">\n          <div class=\"scenario-result-item\"><span>Sim Targets</span><strong id=\"simTargetsVal\">3.6</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Yards</span><strong id=\"simYardsVal\">30.6</strong></div>\n          <div class=\"scenario-result-item\"><span>Sim Edge</span><strong id=\"simEdgeVal\" style=\"color:var(--accent);\">OVER +11.0%</strong></div>\n        </div>\n        <div id=\"teammateRippleWrap\">\n          \n        <div class=\"teammate-ripple-bar\" id=\"teammateRipplePreview\">\n          <span class=\"ripple-lead\">Volume Concentration:</span>\n          <span class=\"ripple-text\">J. Jefferson (33.4%) · J. Jennings (19.2%)</span>\n        </div>\n        </div>\n      </div>\n    \n\n      <!-- Kelly Calculator with Gate Override -->\n      \n      <div class=\"kelly-calc-box\">\n        <div class=\"kelly-calc-header\">\n          <h4>\n            <svg class=\"prop-icon icon-volume\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:13px;height:13px;\"><path d=\"M2 10h3l3 4V2L5 6H2v4z\"/></svg>\n            Interactive Kelly Bet Sizing Calculator\n          </h4>\n          <span style=\"font: 600 10.5px/1 var(--mono); color: var(--muted);\">Kelly cap 3.0%</span>\n        </div>\n        <div class=\"kelly-calc-row\">\n          <label class=\"kelly-input-wrap\">\n            <span>Bankroll $</span>\n            <input type=\"number\" id=\"kellyBankrollInput\" min=\"100\" max=\"1000000\" step=\"100\" value=\"5000\">\n          </label>\n          <div class=\"kelly-result-card\">\n            <span class=\"kelly-stake-amt\" id=\"kellyWagerDollars\">$150.00</span>\n            <span class=\"kelly-stake-pct\" id=\"kellyWagerPct\">(3.00% of bankroll)</span>\n            \n          </div>\n        </div>\n      </div>\n    \n\n      <!-- 2-Column Institutional Spec Grid -->\n      <div class=\"detail-two-col\">\n        <div class=\"detail-col\">\n          \n      <div class=\"quant-card\">\n        <div class=\"quant-card-header\">\n          <span class=\"quant-card-title\">Opportunity Telemetry</span>\n          <span class=\"quant-card-sub\">Featured WR</span>\n        </div>\n        <div class=\"telemetry-grid\">\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Target share</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Rotational</span>\n                  <strong class=\"telemetry-value\">10.6%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:30.2%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Air-yards share</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Intermediate</span>\n                  <strong class=\"telemetry-value\">14.5%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:36.3%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">aDOT</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">Intermediate</span>\n                  <strong class=\"telemetry-value\">8.6 yds</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:54.0%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Catch rate</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">vs 60% exp</span>\n                  <strong class=\"telemetry-value\">61.1%</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:71.8%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Yards / reception</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">High Floor</span>\n                  <strong class=\"telemetry-value\">10.1 yds</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:56.3%\"></div>\n              </div>\n            </div>\n          \n            <div class=\"telemetry-cell\">\n              <div class=\"telemetry-cell-header\">\n                <span class=\"telemetry-label\">Sample size</span>\n                <div class=\"telemetry-vals\">\n                  <span class=\"telemetry-benchmark\">High Confidence</span>\n                  <strong class=\"telemetry-value\">144 games</strong>\n                </div>\n              </div>\n              <div class=\"telemetry-bar-track\">\n                <div class=\"telemetry-bar-fill\" style=\"width:100.0%\"></div>\n              </div>\n            </div>\n          \n        </div>\n      </div>\n    \n        </div>\n        <div class=\"detail-col\">\n          \n      <div class=\"quant-card\">\n        <div class=\"quant-card-header\">\n          <span class=\"quant-card-title\">Probability comparison</span>\n          <button type=\"button\" class=\"receipt-copy-pill\" id=\"copyReceiptBtn\" data-receipt=\"receipt_harness_verified\" title=\"Copy quote receipt identifier\">\n            <span class=\"receipt-dot\"></span>\n            <span class=\"receipt-hash\">#receipt_harness_</span>\n            <span class=\"receipt-copy-icon\">⧉</span>\n          </button>\n        </div>\n\n        <div class=\"bridge-body\">\n          <div class=\"bridge-legend\">\n            <span class=\"legend-mkt\">De-Vigged Mkt: <b class=\"val-mkt\">50.0%</b></span>\n            <span class=\"legend-vig\">Break-Even Vig: <b class=\"val-vig\">52.4%</b> <small>(-110)</small></span>\n            <span class=\"legend-model\">Model Win P: <b class=\"val-model\">61.0%</b></span>\n          </div>\n\n          <div class=\"bridge-track\">\n            <!-- Base Market Probability -->\n            <div class=\"bridge-seg-mkt\" style=\"width:50.0%\"></div>\n            <!-- Vig Tax -->\n            <div class=\"bridge-seg-vig\" style=\"left:50.0%; width:2.4%\"></div>\n            <!-- Net Positive Alpha -->\n            <div class=\"bridge-seg-alpha\" style=\"left:52.4%; width:8.619047619047615%\"></div>\n          </div>\n\n          <div class=\"bridge-footer\">\n            <span class=\"text-muted\">Vig drag: -2.4%</span>\n            <span class=\"text-accent font-bold\">Model difference: 11.0% (8.6% over vig) · Feed verified</span>\n          </div>\n\n          <div class=\"specs-grid\">\n            <div><span>State:</span> <b>Feed verified</b></div>\n            <div><span>Source:</span> <b>Synthetic Book A quote</b></div>\n            <div><span>Gate Hurdle:</span> <b>10%</b></div>\n            <div><span>Kelly Cap:</span> <b>3.0%</b></div>\n          </div>\n        </div>\n      </div>\n    \n        </div>\n      </div>\n\n      <!-- Inline Execution Ticket (CLV Ledger) -->\n      \n      <div class=\"execution-ticket-box\">\n        <div class=\"ticket-header\">\n          <span class=\"ticket-title\"><svg class=\"prop-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" style=\"width:13px;height:13px;\"><path d=\"M2.5 3.5h11a1 1 0 011 1v8a1 1 0 01-1 1h-11a1 1 0 01-1-1v-8a1 1 0 011-1z\"/><path d=\"M5.5 3.5v-1a1 1 0 011-1h4a1 1 0 011 1v1M8 7v4M6 9h4\"/></svg> Execution Ticket · CLV Ledger</span>\n          <span class=\"ticket-status text-muted\">Research draft · confirm at book</span>\n        </div>\n        <div class=\"ticket-fields-row\">\n          <div class=\"ticket-field ticket-side-field\">\n            <span class=\"ticket-lbl\">Side</span>\n            <div class=\"ticket-side-group\" role=\"group\">\n              <button type=\"button\" class=\"side-toggle-btn active side-o\" id=\"ticketSideOver\">O</button>\n              <button type=\"button\" class=\"side-toggle-btn \" id=\"ticketSideUnder\">U</button>\n            </div>\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketLineInput\">Line</label>\n            <input type=\"number\" step=\"0.5\" id=\"ticketLineInput\" class=\"ticket-input\" value=\"2.5\">\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketOddsInput\">Odds</label>\n            <input type=\"text\" id=\"ticketOddsInput\" class=\"ticket-input\" value=\"-110\">\n          </div>\n          <div class=\"ticket-field\">\n            <label class=\"ticket-lbl\" for=\"ticketStakeInput\">Stake $</label>\n            <input type=\"number\" step=\"10\" id=\"ticketStakeInput\" class=\"ticket-input\" value=\"150.00\">\n          </div>\n          <button type=\"button\" class=\"ticket-confirm-btn \" id=\"ticketConfirmBtn\">\n            Confirm Log ↵\n          </button>\n        </div>\n      </div>\n    \n\n      <!-- Institutional 2-Column Terminal Specification Grid (Replacing Text-Heavy Footer) -->\n      <div class=\"spec-grid-card\">\n        <div class=\"spec-col spec-col-invalidation\">\n          <div class=\"spec-header\">\n            <span class=\"spec-title\">Invalidation &amp; Risk Envelope</span>\n            <span class=\"spec-tag tag-dome\">ENV: DOME</span>\n          </div>\n          <div class=\"spec-body\">\n            <div class=\"spec-meta-list\">\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Game Script:</span> <span class=\"spec-v\">MIN spread +2.5</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Venue / Env:</span> <span class=\"spec-v\">Indoor Dome (Controlled Conditions)</span></div>\n              <div class=\"spec-meta-item\"><span class=\"spec-k\">Tail Risk:</span> <span class=\"spec-v\">Late inactive / unmodeled rotation</span></div>\n            </div>\n            \n            \n          </div>\n        </div>\n\n      </div>\n\n      <!-- Sticky Add To Ledger Bar pinned to bottom of bottom sheet -->\n      <div class=\"detail-sticky-bar\">\n        <div class=\"sticky-bar-info\">\n          <span class=\"sticky-verdict\">OVER 2.5 <small class=\"text-dim\">(-110)</small></span>\n          <span class=\"sticky-edge text-accent\">+11.0% edge · $150.00 (3.00%)</span>\n        </div>\n        <button type=\"button\" class=\"detail-sticky-log-btn \" id=\"modalStickyLogBtn\">\n          Review ticket\n        </button>\n      </div>\n    ","textContent":""},"#detailMeta":{"innerHTML":"","textContent":"WR · MIN vs IND · Receiving yards"},"#detailTitle":{"innerHTML":"\n      <div class=\"detail-title-row\" data-team=\"MIN\">\n        <span class=\"pw-avatar pw-avatar-fallback\"><span class=\"pw-avatar-initials\" aria-hidden=\"true\">AT</span><img class=\"pw-avatar-team-badge\" src=\"https://a.espncdn.com/i/teamlogos/nfl/500/min.png\" alt=\"MIN\" title=\"MIN\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\"></span>\n        <span>Adam Thielen</span>\n        <span class=\"detail-side-badge badge-over\">OVER</span>\n        \n      </div>","textContent":""}}