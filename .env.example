# ── Propstein 2.0 ──────────────────────────────────────────────────
# Copy to .env (local preview) — only DATABASE_URL is required.
# Production: Vercel env + GitHub Actions secret carry the same value.

# SQLite preview (bun run db:push && bun scripts/seed.ts)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production Postgres (Supabase pooled / Neon) — matches prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Supabase Auth (Free/Pro tier source of truth; billing webhook writes
# user.subscription_tier -> isPro). Optional in preview — sandbox falls
# back to the propstein_tier cookie demo switch.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Preview-only tier demo switch. In production the switch is OFF and
# POST /api/tier returns 403 (self-elevating to Pro is not allowed).
# Set to "1" only on staging deployments that need the demo toggle.
# ALLOW_TIER_DEMO="1"
