{
  "name": "propstein-research-app",
  "version": "1.2.0",
  "private": true,
  "description": "Institutional quantitative receiving props terminal and CLV ledger.",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\" \"test/**/*.test.cjs\" \"test/**/*.snapshot.mjs\" \"test/**/*.golden.mjs\"",
    "check": "node --check viewer/app.js && node --check viewer/sw.js && npm test",
    "check:production": "npm run check",
    "build:extension": "bash scripts/package_extension.sh",
    "test:extensions": "npm run test:core --prefix extensions",
    "test:all": "npm test && npm run test:extensions",
    "visual:baseline": "node scripts/visual/capture.mjs .visual/baseline --styles",
    "visual:check": "node scripts/visual/capture.mjs .visual/actual --styles && node scripts/visual/compare.mjs .visual/baseline .visual/actual .visual/diff"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "1.57.0",
    "sharp": "^0.35.5"
  }
}
