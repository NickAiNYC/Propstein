{
  "manifest_version": 3,
  "name": "PropStein Live Sniper [DEV]",
  "version": "0.1.0",
  "description": "DEV BUILD — adds localhost fixture host permission for Playwright e2e. Never ship this manifest.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ],
  "optional_host_permissions": [
    "https://propstein.vercel.app/*",
    "https://sportsbook.draftkings.com/*",
    "https://sportsbook.fanduel.com/*",
    "https://polymarket.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PropStein Live Sniper [DEV]"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
  }
}
